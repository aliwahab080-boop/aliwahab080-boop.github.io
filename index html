<!DOCTYPE html>
<html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Salima Transfert</title>
<script src="https://sdk.minepi.com/pi-sdk.js"></script>
<script>try{Pi.init({version:"2.0",sandbox:true});}catch(e){}</script>
<style>
*{box-sizing:border-box;font-family:Arial}body{margin:0;background:#f2f2f2;color:#111;padding-bottom:90px}
.top{background:#b5e800;padding:18px 16px 22px;border-radius:0 0 22px 22px}
.top h1{margin:0;font-size:30px}.top p{margin:4px 0 0;font-size:16px}
.card{margin:12px;background:#fff;border-radius:18px;padding:16px;box-shadow:0 2px 8px #0001}
.green{background:#111;color:#b5e800;border:none;border-radius:12px;padding:14px;font-weight:900;width:100%;font-size:16px}
.lime{background:#b5e800;color:#000;border:none;border-radius:12px;padding:13px;font-weight:900;width:100%;font-size:15px}
.piBtn{background:#7a2bd6;color:#fff;border:none;border-radius:12px;padding:13px;font-weight:900;width:100%;font-size:15px}
input,select{width:100%;padding:13px;margin:7px 0;border-radius:12px;border:1px solid #ddd;background:#fff;font-size:15px}
label{font-size:13px;color:#666}.row{display:flex;gap:10px}.row>*{flex:1}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.gbtn{background:#fff;border-radius:14px;padding:16px;text-align:center;box-shadow:0 2px 8px #0001;font-size:14px;border:none}.gbtn b{display:block;font-size:16px}
.nav{position:fixed;bottom:0;left:0;right:0;background:#fff;display:flex;border-top:1px solid #ddd;padding:8px 0}.nav button{flex:1;background:none;border:none;color:#777;font-size:12px}.nav button.on{color:#000;font-weight:900}
.hide{display:none}.pill{display:inline-block;background:#eee;padding:7px 13px;border-radius:20px;font-size:13px;margin:3px}.pill.on{background:#111;color:#b5e800;font-weight:800}
.hist{border-left:4px solid #b5e800;padding:10px;background:#f9f9f9;border-radius:10px;margin:8px 0}
</style></head><body>
<div class="top"><h1>💚 Salima</h1><p>Admin: +227 99 96 37 77 • PIN 1234</p><p id="piUser" style="font-size:13px;margin-top:6px">🟣 Pi Browser - Non connecté</p></div>

<div id="p-home">
<div class="card"><button class="piBtn" onclick="loginPi()">🟣 SE CONNECTER AVEC PI</button><div id="piMsg" style="text-align:center;font-size:13px;margin-top:8px;color:#555">Connecte-toi avec ton compte Pi pour payer en Pi</div></div>
<div class="card"><div style="display:flex;justify-content:space-between"><span>Solde Pi</span><button onclick="toggleBal()" id="eyeBtn" style="background:#eee;border:none;border-radius:20px;padding:6px 10px">👁️ MASQUER</button></div>
<h1 id="balPi" style="color:#111;margin:6px 0">125.50 Pi</h1><div id="balXof" style="font-size:18px">150 600 FCFA</div>
<div style="color:#666;font-size:13px;margin-top:8px">Taux du jour : 1 Pi = 1 200 FCFA • Niamey</div></div>
<div class="grid" style="padding:0 12px">
<button class="gbtn" onclick="go('envoyer')">💸<b>ENVOYER</b>Transfert</button>
<button class="gbtn" onclick="go('recevoir')">📥<b>RECEVOIR</b>Retrait</button>
<button class="gbtn" onclick="go('historique')">📜<b>HISTORIQUE</b>Mes envois</button>
<button class="gbtn" onclick="window.open('https://wa.me/22799963777')">💬<b>WhatsApp</b>99 96 37 77</button>
</div>
<div class="card"><button class="lime" onclick="window.location.href='tel:+22799963777'">📞 APPELER SALIMA - 99 96 37 77</button></div>
<div class="card"><b>Services Rapides</b><div style="margin-top:10px"><span class="pill">NITA</span><span class="pill">AMANA</span><span class="pill">Airtel Money</span><span class="pill">Moov Money</span><span class="pill">Zamani</span><span class="pill">NIGELEC</span><span class="pill">NDE Eau</span><span class="pill">Pi → XOF</span><span class="pill">Pi → USDT</span></div></div>
</div>

<div id="p-envoyer" class="hide"><div class="card"><h3>💸 Envoyer de l'argent</h3>
<div id="destInfo">Destinataire : <b>Aucun - choisis dans Contacts</b></div>
<label>Service</label><div><span class="pill on" id="sNITA" onclick="setServ('NITA')">NITA</span><span class="pill" id="sAMANA" onclick="setServ('AMANA')">AMANA</span></div><input type="hidden" id="service" value="NITA">
<label>Nom destinataire</label><input id="benNom" placeholder="Nom destinataire">
<label>Numéro destinataire</label><input id="benTel" placeholder="Numéro destinataire +227...">
<label>Montant</label><div class="row"><input id="montant" type="number" placeholder="Montant FCFA" oninput="calc()"><select id="devise" onchange="calc()"><option value="FCFA">FCFA</option><option value="Pi">Pi</option></select></div>
<label>Pays</label><select id="pays" onchange="checkNiger()"><option value="Niger">Niger</option><option>Nigeria</option><option>Ghana</option><option>Bénin</option><option>Togo</option><option>Burkina Faso</option><option>Mali</option><option>Sénégal</option><option>Côte d'Ivoire</option><option>Cameroun</option><option>France</option><option>USA</option><option>Canada</option><option>Allemagne</option><option>Italie</option><option>Espagne</option><option>Belgique</option><option>Suisse</option><option>Tunisie</option><option>Algérie</option><option>Maroc</option><option>Tchad</option><option>Guinée</option><option>Libye</option><option>Arabie Saoudite</option><option>Emirats</option><option>Turquie</option><option>Chine</option><option>Inde</option></select>
<div id="nigerBox"><label>Ville / Village</label><input id="ville" list="villes" placeholder="Ex: Niamey, Maradi, Gaya..."><datalist id="villes"><option>Niamey</option><option>Dosso</option><option>Maradi</option><option>Zinder</option><option>Tahoua</option><option>Agadez</option><option>Tillabéri</option><option>Diffa</option><option>Gaya</option><option>Birni N'Konni</option><option>Tessaoua</option><option>Dogondoutchi</option><option>Filingue</option><option>Say</option><option>Kollo</option><option>Madarounfa</option><option>Magaria</option><option>Mirriah</option><option>Tanout</option><option>Aguié</option><option>Guidan Roumdji</option><option>Illéla</option><option>Keita</option><option>Madaoua</option><option>Mayahi</option><option>Abalak</option><option>Bouza</option><option>Arlit</option><option>Bilma</option><option>Gouré</option><option>Mainé-Soroa</option><option>N'Guigmi</option><option>Ouallam</option><option>Torodi</option><option>Loga</option><option>Boboye</option></datalist></div>
<div id="calcul" style="font-weight:800;margin:8px 0">Frais: 0 FCFA • Total: 0 FCFA</div>
<label>Code PIN (1234)</label><input id="pin" type="password" placeholder="1234" maxlength="4">
<button class="green" onclick="envoyer()">Continuer - Calculer les frais</button>
<div id="msgEnv" style="margin-top:10px;text-align:center"></div>
</div></div>

<div id="p-recevoir" class="hide"><div class="card"><h3>📥 Recevoir</h3><p style="color:#555;line-height:1.6">Le bénéficiaire reçoit un SMS + WhatsApp avec le Code. Il vient avec sa pièce d'identité.</p>
<div style="border:2px dashed #111;padding:14px;border-radius:12px;text-align:center"><b style="font-size:22px" id="codeDemo">Code : SAL4821</b><br><span id="recvDemo">Montant : 50 000 FCFA<br>Expéditeur : Salima<br>Ville : Niamey</span></div>
<button class="lime" style="margin-top:12px" onclick="shareRecv()">💬 PARTAGER LE REÇU SUR WHATSAPP</button></div></div>

<div id="p-services" class="hide"><div class="card"><h3>🛠️ Services</h3><p style="line-height:2">⚡ <b>NITA</b> - Transfert rapide<br>⚡ <b>AMANA</b> - Transfert rapide<br>📱 <b>Airtel Money</b><br>📱 <b>Moov Money</b><br>📱 <b>Zamani</b><br>💡 <b>NIGELEC</b> - Facture électricité<br>💧 <b>NDE Eau</b> - Facture eau<br>🪙 <b>Pi → XOF</b> - 1 Pi = 1 200 FCFA<br>💲 <b>Pi → USDT</b> - Contacte Salima</p></div></div>

<div id="p-historique" class="hide"><div class="card"><h3>📜 Historique</h3>
<div><span class="pill on" onclick="filt('all',this)">Tous</span><span class="pill" onclick="filt('FCFA',this)">FCFA</span><span class="pill" onclick="filt('Pi',this)">Pi</span><span class="pill" onclick="filt('Success',this)">✅ Succès</span><span class="pill" onclick="filt('Annulé',this)">❌ Annulé</span></div>
<div id="histList"></div><div id="emptyHist" style="color:#888;text-align:center;padding:20px">Aucun envoi pour le moment.</div></div></div>

<div id="p-contacts" class="hide"><div class="card"><h3>👥 Mes Contacts</h3><input id="searchC" placeholder="🔍 Rechercher nom ou numéro..." oninput="renderContacts()"><button class="lime" onclick="importPhone()">📱 Importer depuis mon téléphone</button><div id="contactList" style="margin-top:10px">Aucun contact. Ajoute ton premier client 👇</div></div>
<div class="card"><h3>➕ Ajouter Client</h3><input id="cNom" placeholder="Nom complet"><input id="cTel" placeholder="Numéro +227..."><select id="cPays"><option>Niger</option><option>Nigeria</option><option>Ghana</option><option>Bénin</option><option>Togo</option><option>Burkina Faso</option><option>Mali</option><option>Sénégal</option><option>France</option></select><button class="green" onclick="addContact()">Enregistrer Client</button></div></div>

<div class="nav">
<button onclick="go('home')" id="n-home" class="on">🏠<br>Accueil</button>
<button onclick="go('envoyer')" id="n-envoyer">💸<br>Envoyer</button>
<button onclick="go('recevoir')" id="n-recevoir">📥<br>Recevoir</button>
<button onclick="go('services')" id="n-services">🛠️<br>Services</button>
<button onclick="go('historique')" id="n-historique">📜<br>Historique</button>
<button onclick="go('contacts')" id="n-contacts">👥<br>Contacts</button>
</div>
<script>
let hidden=false,curFilt='all';
let hist=JSON.parse(localStorage.getItem('salima_hist')||'[]');
let contacts=JSON.parse(localStorage.getItem('salima_contacts')||'[]');
async function loginPi(){try{let auth=await Pi.authenticate(['username','payments'],function(p){});document.getElementById('piUser').innerText='🟣 Connecté: @'+auth.user.username;document.getElementById('piMsg').innerHTML='<b style="color:green">✅ Bienvenue @'+auth.user.username+' - Tu peux payer en Pi</b>';}catch(e){document.getElementById('piMsg').innerHTML='Ouvre cette app dans <b>Pi Browser</b> pour te connecter. Sur Chrome ça ne marche pas.';}}
function go(p){['home','envoyer','recevoir','services','historique','contacts'].forEach(x=>{document.getElementById('p-'+x).classList.toggle('hide',x!==p);document.getElementById('n-'+x).classList.toggle('on',x===p)});window.scrollTo(0,0);renderHist();renderContacts()}
function toggleBal(){hidden=!hidden;document.getElementById('balPi').innerText=hidden?'••••••':'125.50 Pi';document.getElementById('balXof').innerText=hidden?'•••••• FCFA':'150 600 FCFA';document.getElementById('eyeBtn').innerText=hidden?'👁️ AFFICHER':'👁️ MASQUER'}
function setServ(s){document.getElementById('service').value=s;document.getElementById('sNITA').className='pill'+(s==='NITA'?' on':'');document.getElementById('sAMANA').className='pill'+(s==='AMANA'?' on':'')}
function checkNiger(){document.getElementById('nigerBox').style.display=document.getElementById('pays').value==='Niger'?'block':'none'}
function calc(){let m=parseFloat(document.getElementById('montant').value||0),d=document.getElementById('devise').value;let fcfa=d==='Pi'?m*1200:m;let frais=fcfa<=10000?500:fcfa<=50000?1000:fcfa<=100000?1500:2000;document.getElementById('calcul').innerText='Montant: '+fcfa.toLocaleString()+' FCFA • Frais: '+frais.toLocaleString()+' FCFA • Total: '+(fcfa+frais).toLocaleString()+' FCFA';return{frais,fcfa}}
function envoyer(){if(document.getElementById('pin').value!=='1234'){document.getElementById('msgEnv').innerHTML='<b style="color:red">❌ PIN incorrect. Mets 1234</b>';return}let m=document.getElementById('montant').value;if(!m||!document.getElementById('benNom').value){document.getElementById('msgEnv').innerHTML='<b style="color:red">Remplis nom et montant</b>';return}let c=calc();let code='SAL'+Math.floor(1000+Math.random()*9000);let item={code,ben:document.getElementById('benNom').value,tel:document.getElementById('benTel').value,montant:m,devise:document.getElementById('devise').value,pays:document.getElementById('pays').value,ville:document.getElementById('ville').value||'Niamey',service:document.getElementById('service').value,frais:c.frais,total:c.fcfa+c.frais,date:new Date().toLocaleString('fr-FR'),status:'Success'};hist.unshift(item);localStorage.setItem('salima_hist',JSON.stringify(hist));document.getElementById('msgEnv').innerHTML='<b style="color:green">✅ ENVOYÉ ! Code: '+code+'</b><br><button onclick="shareLast(\''+code+'\')" style="margin-top:10px;background:#25D366;color:#fff;border:none;padding:10px 18px;border-radius:10px;font-weight:800">💬 Envoyer reçu WhatsApp</button>';document.getElementById('codeDemo').innerText='Code : '+code;document.getElementById('recvDemo').innerText='Montant : '+m+' '+document.getElementById('devise').value+'\nExpéditeur : Salima\nVille : '+(document.getElementById('ville').value||'Niamey');renderHist()}
function shareLast(code){let h=hist.find(x=>x.code===code);let txt='🧾 SALIMA TRANSFERT%0A%0ACode: '+code+'%0ABénéficiaire: '+encodeURIComponent(h.ben)+'%0AMontant: '+h.montant+' '+h.devise+'%0AFrais: '+h.frais+' FCFA%0ATotal: '+h.total+' FCFA%0AVille: '+encodeURIComponent(h.ville)+'%0AService: '+h.service+'%0A%0A📞 99 96 37 77';window.open('https://wa.me/'+(h.tel.replace(/\D/g,''))+'?text='+txt)}
function shareRecv(){window.open('https://wa.me/22799963777?text='+encodeURIComponent('Bonjour Salima, je veux recevoir mon transfert. Mon code: SAL4821'))}
function filt(f,el){curFilt=f;document.querySelectorAll('#p-historique .pill').forEach(p=>p.classList.remove('on'));el.classList.add('on');renderHist()}
function renderHist(){let list=document.getElementById('histList');list.innerHTML='';let f=hist.filter(h=>curFilt==='all'||h.devise===curFilt||h.status===curFilt);document.getElementById('emptyHist').style.display=f.length?'none':'block';f.forEach(h=>{list.innerHTML+='<div class="hist"><b>SALIMA - '+h.code+'</b> • '+h.status+'<br>'+h.ben+' - '+h.ville+' ('+h.pays+')<br>'+h.montant+' '+h.devise+' • Frais '+h.frais+' FCFA • Total '+h.total+' FCFA<br><small>'+h.date+' • '+h.service+'</small></div>'})}
function addContact(){let n=document.getElementById('cNom').value,t=document.getElementById('cTel').value;if(!n||!t)return alert('Mets nom + téléphone');contacts.unshift({n,t});localStorage.setItem('salima_contacts',JSON.stringify(contacts));document.getElementById('cNom').value='';document.getElementById('cTel').value='';renderContacts();alert('Client ajouté ✅')}
function renderContacts(){let q=(document.getElementById('searchC')?.value||'').toLowerCase();let l=document.getElementById('contactList');l.innerHTML='';let f=contacts.filter(c=>c.n.toLowerCase().includes(q)||c.t.includes(q));if(!f.length)l.innerHTML='Aucun contact. Ajoute ton premier client 👇';f.forEach(c=>{l.innerHTML+='<div class="hist">'+c.n+'<br>'+c.t+'<br><button onclick="useContact(\''+c.n+'\',\''+c.t+'\')" style="background:#111;color:#b5e800;border:none;padding:7px 12px;border-radius:8px;font-weight:800;margin-top:5px">Utiliser →</button></div>'})}
function useContact(n,t){document.getElementById('benNom').value=n;document.getElementById('benTel').value=t;document.getElementById('destInfo').innerHTML='Destinataire : <b>'+n+' - '+t+'</b>';go('envoyer')}
async function importPhone(){try{let r=await navigator.contacts.select(['name','tel'],{multiple:true});r.forEach(c=>{if(c.name&&c.tel)contacts.unshift({n:c.name[0],t:c.tel[0]})});localStorage.setItem('salima_contacts',JSON.stringify(contacts));renderContacts();alert('Contacts importés ✅')}catch(e){alert('Ton téléphone ne permet pas l\'import auto. Ajoute manuellement en bas 👇')}}
renderHist();renderContacts();
</script></body></html>
