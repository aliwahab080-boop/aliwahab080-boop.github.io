<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SALIMA - FIX FINAL OUVERT</title><style>body{margin:0;background:#000;color:#fff;font-family:Arial;padding-bottom:90px}.h{background:#7ab800;padding:14px;text-align:center}.h h1{margin:8px 0;font-size:30px}.t{display:flex;gap:6px;padding:10px;overflow-x:auto;white-space:nowrap}.t div{background:#222;padding:10px 14px;border-radius:10px;white-space:nowrap;cursor:pointer;flex-shrink:0}.t .a{background:#fff;color:#000;font-weight:bold}.c{background:#111;border:1px solid #222;border-radius:14px;padding:14px;margin:10px}select,input{width:100%;padding:13px;border-radius:10px;margin-top:6px;border:none;background:#fff;color:#000;box-sizing:border-box;font-size:16px}.b{width:100%;padding:14px;border-radius:10px;border:none;background:#7ab800;font-weight:900;margin-top:10px;font-size:15px;cursor:pointer}.b2{background:#222;color:#fff}.n{position:fixed;bottom:0;left:0;right:0;background:#111;display:flex;justify-content:space-around;padding:10px 2px;border-top:1px solid #222;text-align:center;font-size:12px;z-index:999}.n div{cursor:pointer;flex:1}.it{border-bottom:1px solid #222;padding:8px 0}.it button,.it a{padding:6px 9px;border-radius:7px;border:none;font-weight:bold;margin:2px;text-decoration:none;display:inline-block}.g{background:#16a34a;color:#fff}.w{background:#25D366;color:#fff}.r{background:#ef4444;color:#fff}.v{background:#7ab800}.sdt{background:#26a17b;color:#fff}.pi{background:#7d3cff;color:#fff}.eye{background:#fff;color:#000;border:2px solid #000;padding:8px 16px;border-radius:20px;font-weight:900;cursor:pointer;font-size:15px}.avatar{width:70px;height:70px;border-radius:50%;background:#7ab800;display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:900;margin:10px auto;color:#000}#recu{position:fixed;inset:0;background:rgba(0,0,0,.9);z-index:9999;display:none;align-items:center;justify-content:center;padding:15px}#recu>div{background:#fff;color:#000;padding:18px;border-radius:14px;width:100%;max-width:400px;text-align:center;max-height:90vh;overflow:auto}#recuTxt{text-align:left;font-size:15px;line-height:1.8}</style></head><body>

<div id="recu"><div><h2 style="margin:0">🧾 REÇU SALIMA</h2><p style="font-size:12px;margin:5px 0">Salima Transfert - Niamey<br><span id="recuExp">Expéditeur : Ali Wahab - 99963777</span><br><span id="recuPays"></span></p><hr><div id="recuTxt"></div><hr><button class="b" style="background:#25D366;color:#000" onclick="envoyerWhatsApp()">📲 1. ENVOYER REÇU PAR WHATSAPP</button><button class="b" style="background:#ef4444;color:#fff" onclick="envoyerSMS()">📩 2. ENVOYER REÇU PAR SMS</button><button class="b" onclick="window.print()">🖨️ IMPRIMER REÇU</button><button class="b" style="background:#2563eb;color:#fff" onclick="sauvegarderRecu()">💾 SAUVEGARDER REÇU</button><button class="b" style="background:#f59e0b;color:#000" onclick="copierRecu()">📋 COPIER REÇU</button><button class="b b2" onclick="fermerRecu()">Fermer ❌</button><p id="msgRecu" style="font-size:12px;color:#666"></p></div></div>

