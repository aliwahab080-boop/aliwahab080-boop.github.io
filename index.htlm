<div id="t-p" style="display:none"><div class="c" style="text-align:center;background:#1a2e00;border:2px solid #7ab800"><div class="avatar" id="avatarProfil">A</div><h2 id="nomProfil">Ali Wahab</h2><p id="infoProfil">99963777 - @aliwahab</p><p>Pi : <span id="piBalP">0.00</span> Pi | SDT : <span id="sdtBalP">0.00</span> SDT</p><p>📍 Niamey - Niger</p><p style="font-size:14px;color:#7ab800;font-weight:bold">✅ PROFIL AFFICHÉ : <span id="connecteComme">Ali Wahab</span></p><p>Mot de passe : <b id="passAff">1234</b></p><button class="b" type="button" onclick="toggleCache()">👁️ CACHER / MONTRER LES SOLDES</button></div>
<div class="c"><h3>👤 CHANGER DE CLIENT</h3><label>Nom du Client</label><input id="editNom" value="Ali Wahab"><label>Numéro</label><input id="editNum" value="99963777"><label>Username Pi</label><input id="editPi" value="@aliwahab"><button class="b" type="button" onclick="modifierProfil()">💾 SAUVEGARDER PROFIL</button></div>
<div class="c"><h3>🔐 CHANGER MON MOT DE PASSE</h3><label>Ancien Mot de Passe</label><input id="oldPass" type="password" placeholder="Ancien - Mets 1234"><label>Nouveau Mot de Passe</label><input id="newPass" type="password" placeholder="Nouveau - 4 chiffres"><label>Confirmer Nouveau</label><input id="newPass2" type="password" placeholder="Retape nouveau"><button class="b" type="button" onclick="changerPass()">🔐 CHANGER MOT DE PASSE</button><p id="msgPass" style="font-size:13px;color:#ffcc00"></p></div>
