<div class="n"><div onclick="sh('w')">🏠<br>Accueil</div><div onclick="sh('pi')">🟣<br>Pi → SALIMA</div><div onclick="sh('n')">💸<br>NITA / AMANA</div><div onclick="sh('s')">💲<br>SDT Pi</div><div onclick="sh('p')">👤<br>Profil</div></div>
<script>
let dernierRecu='',dernierNum='',dernierCode='',dernierIndicatif='+227',cache=false;
let clientActuel={nom:'Ali Wahab',num:'99963777',pi:'@aliwahab',pass:'1234'};
const PAYS={NE:{nom:'Niger',code:'+227'},NG:{nom:'Nigeria',code:'+234'},BJ:{nom:'Bénin',code:'+229'},GH:{nom:'Ghana',code:'+233'},CI:{nom:"Côte d'Ivoire",code:'+225'},ML:{nom:'Mali',code:'+223'},BF:{nom:'Burkina',code:'+226'},TG:{nom:'Togo',code:'+228'},SN:{nom:'Sénégal',code:'+221'},FR:{nom:'France',code:'+33'},US:{nom:'USA',code:'+1'}};
// ✅ FIX 1 - SOLDES : SANS MOT DE PASSE, JUSTE MONTRER / CACHER - ÇA DOIT MARCHER
function toggleCache(){try{cache=!cache;let b=document.getElementById('eyeTxt');if(b)b.innerText=cache?'MONTRER':'CACHER';let m=document.getElementById('cacheMsg');if(m)m.innerText=cache?'🔒 Soldes cachés - Clique MONTRER pour afficher':'👁️ Soldes affichés - Clique CACHER pour cacher';upd();}catch(e){alert('Erreur solde: '+e.message)}}
// ✅ FIX 2 - NAVIGATION : SIMPLE, SANS ERREUR - PROFIL DOIT S'AFFICHER
function sh(id){try{let ids=['w','pi','s','n','f','v','c','p','h','co'];for(let i=0;i<ids.length;i++){let e=document.getElementById('t-'+ids[i]);if(e)e.style.display=(ids[i]===id?'block':'none');}let tabs=document.querySelectorAll('#topTabs div');for(let i=0;i<tabs.length;i++){tabs[i].classList.remove('a');}let tab=document.getElementById('tab-'+id);if(tab)tab.classList.add('a');if(id=='h')showH();if(id=='c')affC();if(id=='v')affV();window.scrollTo(0,0);}catch(e){alert('Erreur navigation: '+e.message)}}
function changerPass(){try{let oldP=document.getElementById('oldPass').value;let np=document.getElementById('newPass').value;let np2=document.getElementById('newPass2').value;if(oldP!==clientActuel.pass){document.getElementById('msgPass').innerText='❌ Ancien faux ! Actuel : '+clientActuel.pass;return}if(!np||np.length<4){document.getElementById('msgPass').innerText='❌ Nouveau trop court !';return}if(np!==np2){document.getElementById('msgPass').innerText='❌ Les 2 ne sont pas pareils !';return}clientActuel.pass=np;try{localStorage.setItem('profil_salima',JSON.stringify(clientActuel))}catch(e){};document.getElementById('passAff').innerText=np;document.getElementById('msgPass').innerText='✅ Mot de passe changé : '+np;document.getElementById('oldPass').value='';document.getElementById('newPass').value='';document.getElementById('newPass2').value='';alert('✅ Mot de passe changé : '+np);}catch(e){alert('Erreur: '+e.message)}}
function modifierProfil(){try{let nom=(document.getElementById('editNom').value||'').trim();let num=(document.getElementById('editNum').value||'').trim().replace(/[^0-9]/g,'').slice(-8);let pi=(document.getElementById('editPi').value||'').trim();if(!nom||!num)return alert('Mets Nom + Numéro');clientActuel={nom:nom,num:num,pi:pi,pass:clientActuel.pass};try{localStorage.setItem('profil_salima',JSON.stringify(clientActuel))}catch(e){};appliquerProfil();alert('✅ Profil changé : '+nom);}catch(e){alert('Erreur profil: '+e.message)}}
function appliquerProfil(){try{document.getElementById('nomClientTop').innerText=clientActuel.nom;document.getElementById('numClientTop').innerText=clientActuel.num;document.getElementById('nomProfil').innerText=clientActuel.nom;document.getElementById('infoProfil').innerText=clientActuel.num+' - '+clientActuel.pi;document.getElementById('avatarProfil').innerText=clientActuel.nom.charAt(0).toUpperCase();document.
