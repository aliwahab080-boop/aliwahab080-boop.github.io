<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>SALIMA - Transfert</title>
<style>
body{background:#0f0f0f;color:#fff;font-family:Arial;margin:0;padding:10px}
.top{background:#1db954;border-radius:15px;padding:15px}
.top h2{margin:0;font-size:28px}
.badge{background:#222;border-radius:20px;padding:5px 10px;display:inline-block;margin:5px 0;font-size:13px}
.btns{display:flex;gap:8px;margin-top:10px}
.btns button{flex:1;padding:12px;border-radius:10px;border:none;font-weight:bold}
.yellow{background:#ffcc00}
.black{background:#222;color:#fff}
.tabs{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;margin:12px 0}
.tabs button{background:#222;color:#fff;border:none;padding:12px 5px;border-radius:12px;font-size:13px}
.tabs button.active{background:#ffcc00;color:#000}
.card{background:#1e1e1e;border-radius:15px;padding:15px;display:none}
.card.active{display:block}
input,select{width:100%;padding:12px;margin:6px 0 12px 0;border-radius:10px;border:none;background:#333;color:#fff;box-sizing:border-box}
label{font-size:13px;color:#ccc}
.save{background:#ffcc00;width:100%;padding:14px;border:none;border-radius:10px;font-weight:bold;font-size:16px}
.ok{background:#1db954;padding:10px;border-radius:10px;text-align:center;margin:10px 0;display:none}
</style>
</head>
<body>

<div class="top">
<h2>124 000 FCFA 👁️</h2>
<div class="badge">🟢 En ligne &nbsp; 📍 Niamey - Aéroport</div><br>
<div class="badge">💳 SAL-99963777</div><br>
<div class="badge" id="piBadge">🟡 Pi : Non configuré</div>
<p style="font-size:12px;margin:5px 0">1 Pi = 315 000 FCFA | 1 $ = 605 FCFA | 1 € = 655 FCFA</p>
<div class="btns">
<button class="black" onclick="alert('SALIMA verrouillé')">🔒 Verrouiller</button>
<button class="yellow" onclick="showTab('pi',null)">Configurer Pi - CLIQUE ICI</button>
</div>
</div>

<div class="tabs">
<button onclick="showTab('pays',this)">🌍 Pays</button>
<button onclick="showTab('envoi',this)">✈️ Envoi</button>
<button onclick="showTab('profil',this)" class="active">👤 Profil</button>
<button onclick="showTab('facture',this)">🧾 Facture</button>
<button onclick="showTab('cpt',this)">👥 Cpt à Cpt</button>
<button onclick="showTab('banque',this)">🏦 Banque</button>
<button onclick="showTab('pi',this)">🟡 Pi</button>
<button onclick="showTab('recu',this)">📄 Reçu</button>
</div>

<div id="pays" class="card"><h3>🌍 Pays</h3><label>Pays de destination</label><select><option>Niger</option><option>Mali</option><option>Burkina Faso</option><option>Bénin</option><option>Togo</option><option>Sénégal</option><option>Côte d'Ivoire</option><option>Cameroun</option><option>Ghana</option><option>Nigeria</option></select><button class="save" onclick="alert('Pays choisi')">Valider</button></div>

<div id="envoi" class="card"><h3>✈️ Envoi</h3><label>Nom bénéficiaire</label><input placeholder="Nom complet"><label>Téléphone</label><input placeholder="Ex: 90 00 00 00"><label>Montant FCFA</label><input type="number" placeholder="Ex: 50000"><button class="save" onclick="alert('Envoi enregistré !')">Envoyer</button></div>

<div id="profil" class="card active"><h3>👤 Profil Client</h3><label>Nom complet</label><input value="Ali Abdoulwahab"><label>Téléphone</label><input value="99963777"><label>Pays</label><select><option>Niger</option></select><button class="save" onclick="alert('Profil sauvegardé')">Sauvegarder</button></div>

<div id="facture" class="card"><h3>🧾 Facture</h3><p>Montant : 124 000 FCFA<br>Frais : 1 000 FCFA<br><b>Total : 125 000 FCFA</b></p><button class="save" onclick="alert('Facture générée')">Générer Facture</button></div>

<div id="cpt" class="card"><h3>👥 Compte à Compte</h3><label>De SAL-</label><input value="SAL-99963777"><label>Vers SAL-</label><input placeholder="SAL-..."><label>Montant</label><input type="number" placeholder="Montant"><button class="save" onclick="alert('Transfert Cpt à Cpt fait')">Transférer</button></div>

<div id="banque" class="card"><h3>🏦 Banque</h3><label>Banque</label><select><option>BOA Niger</option><option>Ecobank</option><option>BSIC</option><option>Banque Atlantique</option></select><label>Numéro de compte</label><input placeholder="N° compte"><label>Montant</label><input type="number" placeholder="Montant"><button class="save" onclick="alert('Envoi banque enregistré')">Envoyer à la banque</button></div>

<div id="pi" class="card"><h3>🟡 Payer avec Pi</h3><div class="ok" id="piOk">✅ TU ES DANS PI !</div><label>Ton Wallet Pi (commence par G...)</label><input id="walletPi" placeholder="G..."><label>Montant en Pi</label><input type="number" id="montantPi" placeholder="Ex: 0.5"><button class="save" onclick="sauvegarderPi()">💾 SAUVEGARDER CONFIG PI</button><p id="piResult" style="margin-top:10px"></p></div>

<div id="recu" class="card"><h3>📄 Reçu</h3><p>Reçu SALIMA<br>Client : Ali Abdoulwahab<br>Tél : 99963777<br>Montant : 124 000 FCFA<br>Statut : ✅ Payé</p><button class="save" onclick="alert('Reçu prêt')">Imprimer Reçu</button></div>

<script>
function showTab(id,btn){
  var cards=document.querySelectorAll('.card');
  for(var i=0;i<cards.length;i++){cards[i].classList.remove('active');}
  document.getElementById(id).classList.add('active');
  var tabs=document.querySelectorAll('.tabs button');
  for(var j=0;j<tabs.length;j++){tabs[j].classList.remove('active');}
  if(btn){btn.classList.add('active');}
  if(id==='pi'){document.getElementById('piOk').style.display='block';}
  window.scrollTo(0,0);
}
function sauvegarderPi(){
  var w=document.getElementById('walletPi').value;
  var m=document.getElementById('montantPi').value;
  if(!w || w.length<5){alert('Mets ton Wallet Pi qui commence par G');return;}
  document.getElementById('piBadge').innerHTML='🟢 Pi : Configuré - '+w.substring(0,6)+'...';
  document.getElementById('piResult').innerHTML='✅ Wallet sauvegardé : '+w+'<br>Montant : '+m+' Pi = '+(m*315000)+' FCFA';
  alert('✅ PI CONFIGURÉ !');
}
</script>
</body>
</html>
